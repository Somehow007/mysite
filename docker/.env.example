# Docker 环境变量配置
# 复制此文件为 .env 并修改相应的值（.env 已被 .gitignore 排除，真实密码不要提交进仓库）

# MySQL 配置（仅在首次初始化数据卷时生效；已有 mysql_data 卷不受影响）
MYSQL_ROOT_PASSWORD=change-me-strong-password

# PostgreSQL (pgvector, RAG) 配置
# 不设置时 compose 回退默认值 ragent/ragent123 —— 仅限本地开发，生产必须在此或 deploy/config/.env 中更换
# RAGENT_PG_PASSWORD=change-me-strong-password

# Elasticsearch 配置（ES 服务默认注释不启动；如启用需自行补齐安全配置）
# ELASTIC_PASSWORD=change-me

# 时区配置
TZ=Asia/Shanghai
