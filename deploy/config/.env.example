DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_database_password_here

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_SECRET=mysite-jwt-secret-key-must-be-at-least-256-bits-long-for-hs256-algorithm-2026

# RAG PostgreSQL（application-production.yml 读取）
RAGENT_PG_HOST=localhost
RAGENT_PG_PORT=5432
RAGENT_PG_DB=ragent
RAGENT_PG_USER=ragent
RAGENT_PG_PASSWORD=ragent123

# 加密入库 LLM API Key 的主密钥（32 字节 Base64）。生成：openssl rand -base64 32
# 本地与 /opt/mysite/.env 各写一次，备份到密码管理器，不要提交 git。丢了主密钥则密文解不开。
MYSITE_CRYPTO_KEY=

# LLM API Keys：仅作首次引导（yaml ${DEEPSEEK_API_KEY:}）。后台保存后以 PG 密文为准，不再回写本文件。
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
BAILIAN_API_KEY=
BAILIAN_CHAT_MODEL=qwen3-max
BAILIAN_EMBEDDING_MODEL=text-embedding-v4
BAILIAN_EMBEDDING_DIMENSION=1024
BAILIAN_RERANK_MODEL=qwen3-rerank
SILICONFLOW_API_KEY=
SILICONFLOW_CHAT_MODEL=glm-4.7
AIHUBMIX_API_KEY=
AIHUBMIX_CHAT_MODEL=gpt-5.4
OLLAMA_CHAT_MODEL=qwen3:8b
